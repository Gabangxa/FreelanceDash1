modules = ["python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[deployment]
deploymentTarget = "autoscale"
# Run migrations before serving so a schema-changing deploy can't boot
# against a stale database. app.py only WARNS when behind head; it does
# not refuse to start. The [postMerge] hook below upgrades the *dev*
# workspace DB, but production autoscale deploys never run it -- they run
# only this command -- so the upgrade has to live here too. Migrations are
# existence-guarded, so concurrent autoscale instances racing through
# `flask db upgrade` converge safely. Flags mirror the "Production Server"
# workflow: --timeout 120 so gunicorn's 30s default doesn't kill PDF
# requests at the render budget (_PDF_RENDER_TIMEOUT_SECONDS=30).
run = ["sh", "-c", "FLASK_APP=app:app flask db upgrade && exec gunicorn --bind 0.0.0.0:5000 --workers 4 --timeout 120 --access-logfile - --error-logfile - main:app"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Production Server"

[[workflows.workflow]]
name = "Production Server"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "gunicorn --bind 0.0.0.0:5000 --workers 4 --timeout 120 --access-logfile - --error-logfile - main:app"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[agent]
integrations = ["flask_google_oauth:1.0.0"]
